{
  "version": 1,
  "library_name": "fixed_ai_voice_mix_profiles",
  "default_profile_id": "VOICE_MALE_THICK_YUNYANG_V1",
  "rules": {
    "normal_tts_speed_range": [0.95, 1.03],
    "approved_fast_policy": "voice_speed_policy=user_approved_1_1x and tts_speed<=1.10",
    "root_narration_bed_required": true,
    "amix_normalize": 0,
    "sfx_must_not_hide_voice": true,
    "sfx_audibility_report_required": true,
    "effective_sfx_peak_after_gain_dbfs_min": -15.0,
    "sfx_overlay_after_final_allowed_when_voice_video_passed": true
  },
  "profiles": [
    {
      "id": "VOICE_MALE_THICK_YUNYANG_V1",
      "name": "厚实男讲师默认",
      "use_when": ["recurring AI knowledge", "daily AI tip", "用户要求男声", "有力", "浑厚"],
      "provider": "edge_tts",
      "voice_id": "zh-CN-YunyangNeural",
      "provider_rate": "+10%",
      "tts_speed": 1.0,
      "voice_speed_policy": "normal_default_or_user_approved_1_1x",
      "mix_preset": "thick-male",
      "voice_gain_range": [1.35, 1.55],
      "sfx_gain_range": [0.45, 0.6],
      "sfx_audibility_policy": "If the fixed SFX bed is too quiet, raise gain until source_sfx_max + gain_db >= -15dBFS, or overlay the root SFX bed on the approved final MP4 while preserving narration.",
      "eq_chain": ["highpass 65Hz", "120Hz +4.2dB", "220Hz +2.5dB", "3200Hz +1.2dB"],
      "compressor": "threshold=-20dB ratio=2.8 attack=8 release=95 makeup=2.2",
      "limiter": "0.88-0.90",
      "qa": ["ffprobe_duration_match", "volumedetect_max_volume", "sfx_audibility_effective_peak_min_-15dBFS", "silencedetect_-45dB_0.75_no_bad_gap", "blackdetect_no_empty_black"]
    },
    {
      "id": "VOICE_MALE_BALANCED_V1",
      "name": "清晰男声保守版",
      "use_when": ["proof-heavy tutorial", "official source explainer", "SFX较多"],
      "provider": "edge_tts",
      "voice_id": "zh-CN-YunyangNeural",
      "provider_rate": "+6%",
      "tts_speed": 1.0,
      "voice_speed_policy": "normal_default",
      "mix_preset": "balanced",
      "voice_gain_range": [1.2, 1.35],
      "sfx_gain_range": [0.32, 0.45],
      "eq_chain": ["highpass 65Hz", "light compression"],
      "compressor": "threshold=-20dB ratio=2.4 attack=8 release=95 makeup=1.5",
      "limiter": "0.90",
      "qa": ["ffprobe_duration_match", "volumedetect", "silencedetect"]
    },
    {
      "id": "VOICE_NO_VOICE_SFX_ONLY_V1",
      "name": "竖版无人声信息海报",
      "use_when": ["scheme_1_skill_recommendation_no_voice", "用户明确无人声"],
      "provider": "none",
      "voice_id": "none",
      "provider_rate": "none",
      "tts_speed": 0,
      "voice_speed_policy": "no_voice",
      "mix_preset": "sfx-only",
      "voice_gain_range": [0, 0],
      "sfx_gain_range": [0.35, 0.5],
      "eq_chain": [],
      "compressor": "not_applicable",
      "limiter": "0.88",
      "qa": ["no_voice_intent_recorded", "sfx_not_clipping", "no_silence_claim_as_voice"]
    }
  ]
}
