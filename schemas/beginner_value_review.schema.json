{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beginner value review",
  "type": "object",
  "required": ["status", "final_decision", "total_score", "scores", "rewrite_required"],
  "properties": {
    "status": { "enum": ["passed", "failed"] },
    "final_decision": { "enum": ["pass", "fail"] },
    "total_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "scores": {
      "type": "object",
      "required": [
        "title_clarity",
        "first_5_seconds_pull",
        "beginner_task_fit",
        "visible_result",
        "step_by_step_value",
        "time_saving_claim",
        "problem_example_score",
        "jargon_translation",
        "save_asset"
      ],
      "properties": {
        "title_clarity": { "type": "number", "minimum": 0, "maximum": 10 },
        "first_5_seconds_pull": { "type": "number", "minimum": 0, "maximum": 10 },
        "beginner_task_fit": { "type": "number", "minimum": 0, "maximum": 10 },
        "visible_result": { "type": "number", "minimum": 0, "maximum": 10 },
        "step_by_step_value": { "type": "number", "minimum": 0, "maximum": 10 },
        "time_saving_claim": { "type": "number", "minimum": 0, "maximum": 10 },
        "problem_example_score": { "type": "number", "minimum": 0, "maximum": 10 },
        "jargon_translation": { "type": "number", "minimum": 0, "maximum": 10 },
        "save_asset": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "rewrite_required": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "object" },
    "signals": { "type": "object" }
  }
}
