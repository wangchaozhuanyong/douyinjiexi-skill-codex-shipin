{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Director Selection",
  "type": "object",
  "required": [
    "status",
    "content_job_lock",
    "scheme",
    "reference_policy",
    "visual_system",
    "component_mix",
    "motion_palette",
    "why_selected",
    "why_not_other_schemes"
  ],
  "properties": {
    "status": {"enum": ["passed", "locked"]},
    "content_job_lock": {"type": "string", "minLength": 10},
    "scheme": {
      "type": "object",
      "required": ["id", "name", "format"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "format": {"type": "string"}
      }
    },
    "reference_policy": {
      "type": "object",
      "required": ["selected_reference_cards", "reference_scope", "forbidden_copying", "latest_reference_is_not_default"],
      "properties": {
        "selected_reference_cards": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "reference_scope": {"type": "string"},
        "forbidden_copying": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "latest_reference_is_not_default": {"type": "boolean"}
      }
    },
    "visual_system": {"type": "object"},
    "component_mix": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "motion_palette": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "why_selected": {"type": "string", "minLength": 20},
    "why_not_other_schemes": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  }
}
