{
  "version": 1,
  "library_name": "fixed_ai_component_template_packs",
  "selection_policy": "scheme_fit_then_sequential_rotation",
  "rules": {
    "components_are_shapes_not_copy": true,
    "one_video_uses_one_component_pack": true,
    "component_pack_must_inherit_visual_family": true,
    "no_same_glass_card_for_everything": true
  },
  "packs": [
    {
      "id": "COMP_PACK_01",
      "name": "来源教程证明链",
      "scheme_ids": ["scheme_2_source_led_tool_tutorial", "scheme_6_operation_proof_short"],
      "components": ["result_first_hook", "source_wall_grid", "cursor_trace_click", "proof_card_snap", "final_core_converge"],
      "caption_families": ["proof_callout", "operation_lower_third", "bottom_glass_keyword", "final_takeaway"],
      "layout_rule": "先给结果，再给来源，再给操作，最后汇聚成可复制步骤。",
