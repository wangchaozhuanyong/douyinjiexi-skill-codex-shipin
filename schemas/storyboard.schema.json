{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "required": ["title", "target", "quality_spec", "director_shots", "scenes"],
  "properties": {
    "title": { "type": "string" },
    "quality_spec": {
      "type": "object",
      "required": [
        "target_quality_level",
        "visual_system",
        "motion_policy",
        "still_image_policy",
        "evidence_policy",
        "sfx_policy",
        "render_policy",
        "cover_policy",
        "frame_review_policy",
        "provider_policy",
        "runtime_choice",
        "caption_template_plan",
        "timeline_contract_ref",
        "narration_continuity_policy"
      ],
      "properties": {
        "target_quality_level": { "enum": ["high_quality", "breakout_potential"] },
        "visual_system": { "type": "string" },
        "motion_policy": { "type": "string" },
        "still_image_policy": { "type": "string" },
        "evidence_policy": { "type": "string" },
        "sfx_policy": { "type": "string" },
        "render_policy": { "type": "string" },
        "cover_policy": { "type": "string" },
        "frame_review_policy": { "type": "string" },
        "provider_policy": { "enum": ["free_first_local_or_authorized_openai_only"] },
        "runtime_choice": { "type": "string" },
        "caption_template_plan": { "type": "string" },
        "timeline_contract_ref": { "type": "string" },
        "narration_continuity_policy": { "type": "string" }
      }
    },
    "production_stack": {
      "type": "object",
      "required": ["reference_learning_applied", "workflow_order", "primary_tools"],
      "properties": {
        "reference_learning_applied": { "type": "boolean" },
        "reference_pattern": { "type": "string" },
        "workflow_order": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "primary_tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role", "evidence_chain"],
            "properties": {
              "name": { "type": "string" },
              "aliases": { "type": "array", "items": { "type": "string" } },
              "role": { "type": "string" },
              "evidence_chain": {
                "type": "object",
                "required": ["entry_or_source", "operation_or_step", "output_or_result", "viewer_value"],
                "properties": {
                  "entry_or_source": { "type": "string" },
                  "operation_or_step": { "type": "string" },
                  "output_or_result": { "type": "string" },
                  "viewer_value": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "codex_plugin_plan": {
      "type": "object",
      "required": ["use_case", "plugins", "blocked_plugins", "approval_required_for"],
      "properties": {
        "use_case": { "type": "string" },
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "availability",
              "role",
              "allowed_by_default",
              "evidence_required",
              "cost_or_auth_boundary",
              "fallback"
            ],
            "properties": {
              "name": { "type": "string" },
              "availability": {
                "enum": [
                  "available_in_session",
                  "available_if_authenticated",
                  "local_cli_or_skill",
                  "needs_user_approval",
                  "optional_blocked",
                  "not_available"
                ]
              },
              "role": { "type": "string" },
              "allowed_by_default": { "type": "boolean" },
              "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "cost_or_auth_boundary": { "type": "string" },
              "fallback": { "type": "string" }
            }
          }
        },
        "blocked_plugins": { "type": "array", "items": { "type": "string" } },
        "approval_required_for": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "required": ["width", "height", "fps", "tts_speed", "voice_speed_policy", "provider_policy"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" },
        "tts_speed": { "type": "number", "minimum": 0.95, "maximum": 1.1 },
        "voice_speed_policy": { "enum": ["normal", "normal_speed", "user_approved_1_1x", "explicit_user_override", "user_requested"] },
        "voice_speed_approval": { "type": "string" },
        "provider_policy": { "enum": ["free_first_local_or_authorized_openai_only"] }
      }
    },
    "director_shots": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "duration_sec",
          "shot_type",
          "layout_family",
          "camera_scale",
          "camera_motion",
          "visual_subject",
          "primary_action",
          "viewer_focus",
          "operation_elements",
          "evidence",
          "on_screen_text",
          "forbidden_risks"
        ],
        "properties": {
          "shot_id": { "type": "string" },
          "duration_sec": { "type": "number", "minimum": 0 },
          "shot_type": {
            "enum": [
              "hook_conflict",
              "source_evidence",
              "concept_shift",
              "wrong_way_demo",
              "method_template",
              "operation_simulation",
              "final_template",
              "result_reveal",
              "comparison",
              "proof_wall"
            ]
          },
          "layout_family": {
            "enum": [
              "workspace_ui",
              "source_crop",
              "citation_card",
              "concept_transform",
              "operation_timeline",
              "terminal_output",
              "repo_file_tree",
              "risk_list",
              "template_card",
              "final_cta",
              "proof_wall",
              "comparison_split"
            ]
          },
          "camera_scale": {
            "enum": ["macro_closeup", "closeup", "medium", "wide", "full_workspace"]
          },
          "camera_motion": {
            "enum": ["static", "push_in", "pull_out", "tracking", "zoom_in", "parallax", "cut", "crossfade"]
          },
          "visual_subject": { "type": "string" },
          "primary_action": { "type": "string" },
          "viewer_focus": { "type": "string" },
          "operation_elements": {
            "type": "array",
            "items": {
              "enum": [
                "task_brief_panel",
                "repo_or_file_tree",
                "risk_list",
                "module_change",
                "test_or_check_output",
                "evidence_result_card",
                "source_citation",
                "none"
              ]
            }
          },
          "evidence": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "real_source_crop",
                  "clean_citation_card",
                  "abstract_non_official_diagram",
                  "real_ui_capture",
                  "terminal_or_file_proof"
                ]
              },
              "asset_id": { "type": "string" },
              "source_url": { "type": "string" },
              "source_title": { "type": "string" },
              "source_date": { "type": "string" },
              "min_display_duration_sec": { "type": "number" },
              "min_visible_width_px": { "type": "integer" },
              "must_be_readable": { "type": "boolean" }
            }
          },
          "on_screen_text": {
            "type": "object",
            "required": ["primary", "approved_primary_text"],
            "properties": {
              "primary": { "type": "string" },
              "secondary": { "type": "array", "items": { "type": "string" } },
              "approved_primary_text": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          },
          "forbidden_risks": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "concept",
          "duration_target",
          "voice",
          "caption",
          "on_screen_text",
          "visual",
          "motion",
          "sync",
          "safe_zone",
          "beat_map",
          "qa_notes"
        ],
        "properties": {
          "scene_id": { "type": "string" },
          "concept": { "type": "string" },
          "duration_target": { "type": "number", "minimum": 0 },
          "voice": { "type": "string" },
          "caption": { "type": "string" },
          "on_screen_text": { "type": "array", "items": { "type": "string" } },
          "text_layers": {
            "type": "object",
            "properties": {
              "primary_read_text": { "type": "array", "items": { "type": "string" } },
              "evidence_embedded_text": { "type": "array", "items": { "type": "string" } },
              "support_label_text": { "type": "array", "items": { "type": "string" } }
            }
          },
          "primary_read_text": { "type": "array", "items": { "type": "string" } },
          "visual": {
            "type": "object",
            "required": [
              "scene_type",
              "description",
              "evidence_source",
              "asset_path",
              "asset_source_type",
              "caption_template",
              "design_layers",
              "quality_checks"
            ],
            "properties": {
              "scene_type": {
                "enum": [
                  "real_ui_demo",
                  "screenshot_proof",
                  "generated_visual",
                  "text_card",
                  "cover",
                  "transition",
                  "comparison",
                  "proof_wall",
                  "code_or_file_proof",
                  "result_reveal",
                  "timeline_process"
                ]
              },
              "description": { "type": "string" },
              "evidence_source": { "type": "string" },
              "asset_path": { "type": "string" },
              "asset_source_type": { "enum": ["proof", "support", "generated", "free_stock"] },
              "caption_template": {
                "enum": [
                  "word_highlight",
                  "side_label",
                  "proof_callout",
                  "terminal_code_caption",
                  "chapter_card",
                  "final_takeaway",
                  "bottom_light_caption",
                  "comparison_label"
                ]
              },
              "design_layers": { "type": "array", "minItems": 3, "items": { "type": "string" } },
              "quality_checks": {
                "type": "object",
                "required": ["source_resolution_ok", "text_safe", "not_template_like", "not_static_dump"],
                "properties": {
                  "source_resolution_ok": { "type": "boolean", "const": true },
                  "text_safe": { "type": "boolean", "const": true },
                  "not_template_like": { "type": "boolean", "const": true },
                  "not_static_dump": { "type": "boolean", "const": true }
                }
              },
              "proof_chain": {
                "type": "object",
                "required": ["entry_or_source", "operation_or_step", "output_or_result", "viewer_value"],
                "properties": {
                  "entry_or_source": { "type": "string" },
                  "operation_or_step": { "type": "string" },
                  "output_or_result": { "type": "string" },
                  "viewer_value": { "type": "string" }
                }
              }
            }
          },
          "motion": {
            "type": "object",
            "required": [
              "background_motion",
              "foreground_motion",
              "callout_motion",
              "transition",
              "purpose",
              "entrance",
              "stagger",
              "keyword_motion",
              "camera_motion",
              "layering",
              "caption_motion",
              "glow",
              "audio_reactive",
              "negative_motion"
            ],
            "properties": {
              "purpose": { "type": "string" },
              "background_motion": { "type": "string" },
              "foreground_motion": { "type": "string" },
              "callout_motion": { "type": "string" },
              "transition": { "type": "string" },
              "entrance": { "type": "string" },
              "stagger": { "type": "string" },
              "keyword_motion": { "type": "string" },
              "camera_motion": { "type": "string" },
              "layering": { "type": "string" },
              "caption_motion": { "type": "string" },
              "glow": { "type": "string" },
              "audio_reactive": { "type": "string" },
              "negative_motion": { "type": "string" }
            }
          },
          "sync": {
            "type": "object",
            "required": [
              "voice_start",
              "voice_end",
              "caption_start",
              "caption_end",
              "narration_track",
              "transition_audio_policy",
              "max_audio_gap_ms",
              "audio_bridge"
            ],
            "properties": {
              "voice_start": { "type": "number", "minimum": 0 },
              "voice_end": { "type": "number", "minimum": 0 },
              "caption_start": { "type": "number", "minimum": 0 },
              "caption_end": { "type": "number", "minimum": 0 },
              "narration_track": { "type": "string" },
              "transition_audio_policy": { "type": "string" },
              "max_audio_gap_ms": { "type": "integer", "minimum": 0, "maximum": 120 },
              "audio_bridge": { "type": "string" }
            }
          },
          "safe_zone": {
            "type": "object",
            "required": [
              "top_reserved",
              "bottom_caption_reserved",
              "right_buttons_reserved",
              "top_margin_px",
              "bottom_margin_px",
              "left_margin_px",
              "right_margin_px",
              "critical_content_inside_safe_area"
            ],
            "properties": {
              "top_reserved": { "type": "boolean", "const": true },
              "bottom_caption_reserved": { "type": "boolean", "const": true },
              "right_buttons_reserved": { "type": "boolean", "const": true },
              "top_margin_px": { "type": "integer", "minimum": 240 },
              "bottom_margin_px": { "type": "integer", "minimum": 360 },
              "left_margin_px": { "type": "integer", "minimum": 72 },
              "right_margin_px": { "type": "integer", "minimum": 180 },
              "critical_content_inside_safe_area": { "type": "boolean", "const": true }
            }
          },
          "beat_map": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["voice_fragment", "visual_action", "caption", "proof_or_explanation", "motion_trigger"],
              "properties": {
                "voice_fragment": { "type": "string" },
                "visual_action": { "type": "string" },
                "caption": { "type": "string" },
                "proof_or_explanation": { "type": "string" },
                "motion_trigger": { "type": "string" }
              }
            }
          },
          "qa_notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
