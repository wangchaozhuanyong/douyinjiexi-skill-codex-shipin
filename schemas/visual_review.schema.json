{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual aesthetic review",
  "type": "object",
  "required": ["status", "overall_visual_score", "scores", "blocking_issues", "warnings", "signals"],
  "properties": {
    "status": { "enum": ["passed", "failed"] },
    "overall_visual_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "scores": { "type": "object" },
    "blocking_issues": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "signals": { "type": "object" }
  }
}
