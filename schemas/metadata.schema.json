{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production metadata",
  "type": "object",
  "required": ["task_id", "created_at", "final_video_path", "duration", "scene_count", "target_width", "target_height", "fps", "tts_speed", "quality_spec"],
  "properties": {
    "task_id": { "type": "string" },
    "created_at": { "type": "string" },
    "final_video_path": { "type": "string" },
    "duration": { "type": "number", "minimum": 0 },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "scene_count": { "type": "integer", "minimum": 0 },
    "voice_id": { "type": "string" },
    "tts_speed": { "type": "number", "minimum": 0.95, "maximum": 1.1 },
    "voice_speed_policy": { "enum": ["normal", "normal_speed", "user_approved_1_1x", "explicit_user_override", "user_requested"] },
    "voice_speed_approval": { "type": "string" },
    "template_id": { "type": "string" },
    "bgm_path": { "type": "string" },
    "bgm_volume": { "type": "number" },
    "target_width": { "type": "integer" },
    "target_height": { "type": "integer" },
    "fps": { "type": "integer" },
    "quality_spec": {
      "type": "object",
      "required": [
        "target_quality_level",
        "render_quality",
        "min_bitrate",
        "source_asset_policy",
        "sfx_policy",
        "cover_policy",
        "frame_review_policy",
        "provider_policy",
        "runtime_choice",
        "caption_template_plan",
        "timeline_contract_ref",
        "narration_continuity_policy"
      ],
      "properties": {
        "target_quality_level": { "enum": ["high_quality", "breakout_potential"] },
        "render_quality": { "enum": ["hyperframes_high", "high_bitrate_h264", "hyperframes_high_plus_remux"] },
        "min_bitrate": { "type": "integer", "minimum": 3500000 },
        "source_asset_policy": { "type": "string" },
        "sfx_policy": { "type": "string" },
        "cover_policy": { "type": "string" },
        "frame_review_policy": { "type": "string" },
        "provider_policy": { "enum": ["free_first_local_or_authorized_openai_only"] },
        "runtime_choice": { "type": "string" },
        "caption_template_plan": { "type": "string" },
        "timeline_contract_ref": { "type": "string" },
        "narration_continuity_policy": { "type": "string" }
      }
    }
  }
}
