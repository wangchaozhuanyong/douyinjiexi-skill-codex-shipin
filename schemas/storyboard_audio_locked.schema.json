{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audio locked storyboard",
  "type": "object",
  "required": ["title", "target", "quality_spec", "scenes", "audio_lock"],
  "properties": {
    "title": { "type": "string" },
    "target": { "type": "object" },
    "quality_spec": { "type": "object" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "duration_target", "sync"],
        "properties": {
          "scene_id": { "type": "string" },
          "duration_target": { "type": "number", "minimum": 0 },
          "sync": {
            "type": "object",
            "required": [
              "voice_start",
              "voice_end",
              "caption_start",
              "caption_end",
              "audio_path",
              "narration_track",
              "transition_audio_policy",
              "max_audio_gap_ms",
              "audio_bridge"
            ],
            "properties": {
              "voice_start": { "type": "number", "minimum": 0 },
              "voice_end": { "type": "number", "minimum": 0 },
              "caption_start": { "type": "number", "minimum": 0 },
              "caption_end": { "type": "number", "minimum": 0 },
              "audio_path": { "type": "string" },
              "narration_track": { "type": "string" },
              "transition_audio_policy": { "type": "string" },
              "max_audio_gap_ms": { "type": "integer", "minimum": 0, "maximum": 120 },
              "audio_bridge": { "type": "string" }
            }
          }
        }
      }
    },
    "audio_lock": {
      "type": "object",
      "required": [
        "narration_track",
        "root_narration_path",
        "scene_audio",
        "total_audio_duration",
        "final_audio_duration",
        "max_audio_gap_ms",
        "transition_audio_policy"
      ],
      "properties": {
        "narration_track": { "type": "string" },
        "root_narration_path": { "type": "string" },
        "scene_audio": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scene_id", "audio_path", "duration", "start", "end", "max_audio_gap_ms"],
            "properties": {
              "scene_id": { "type": "string" },
              "audio_path": { "type": "string" },
              "duration": { "type": "number", "minimum": 0 },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "minimum": 0 },
              "max_audio_gap_ms": { "type": "integer", "minimum": 0, "maximum": 120 }
            }
          }
        },
        "total_audio_duration": { "type": "number", "minimum": 0 },
        "final_audio_duration": { "type": "number", "minimum": 0 },
        "duration_delta": { "type": "number", "minimum": 0 },
        "max_audio_gap_ms": { "type": "integer", "minimum": 0, "maximum": 120 },
        "transition_audio_policy": { "type": "string" }
      }
    }
  }
}
