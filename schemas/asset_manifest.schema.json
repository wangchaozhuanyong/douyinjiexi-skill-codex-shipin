{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset manifest",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "type",
          "path",
          "source",
          "provider",
          "asset_source_type",
          "source_note",
          "copyright_status",
          "resolution",
          "used_in_scenes",
          "is_evidence",
          "risk",
          "contains_private_info",
          "contains_contact_info",
          "contains_qr_code",
          "qa_notes"
        ],
        "properties": {
          "asset_id": { "type": "string" },
          "evidence_visual_type": {
            "enum": [
              "real_source_crop",
              "clean_citation_card",
              "abstract_non_official_diagram",
              "real_ui_capture",
              "terminal_or_file_proof",
              "none"
            ]
          },
          "source_title": { "type": "string" },
          "source_date": { "type": "string" },
          "source_url": { "type": "string" },
          "crop_path": { "type": "string" },
          "used_in_shots": { "type": "array", "items": { "type": "string" } },
          "min_display_duration_sec": { "type": "number" },
          "min_visible_width_px": { "type": "integer" },
          "must_be_readable": { "type": "boolean" },
          "asset_role": {
            "enum": [
              "background_plate",
              "hero_poster",
              "metaphor_visual",
              "transition_plate",
              "diagram_base",
              "cover",
              "texture",
              "support_card",
              "proof_asset"
            ]
          },
          "type": {
            "enum": [
              "real_ui_screenshot",
              "real_ui_recording",
              "terminal_output",
              "code_or_file_proof",
              "official_doc_screenshot",
              "generated_visual",
              "designed_card",
              "audio",
              "subtitle",
              "other"
            ]
          },
          "path": { "type": "string" },
          "source": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "prompt_id": { "type": "string" },
          "prompt_path": { "type": "string" },
          "unique_prompt": { "type": "boolean" },
          "evidence_boundary": { "type": "string" },
          "visual_thesis": { "type": "string" },
          "topic_binding": { "type": "string" },
          "information_job": { "type": "string" },
          "background_role": { "type": "string" },
          "scene_id": { "type": "string" },
          "narration_line_supported": { "type": "string" },
          "scene_function": { "type": "string" },
          "visual_archetype": { "type": "string" },
          "brightness_grade": { "type": "string" },
          "palette_family": { "type": "string" },
          "material_family": { "type": "string" },
          "layout_family": { "type": "string" },
          "energy_level": { "type": "string" },
          "beginner_usefulness": { "type": "string" },
          "viewer_takeaway": { "type": "string" },
          "composition": { "type": "string" },
          "foreground": { "type": "string" },
          "midground": { "type": "string" },
          "background": { "type": "string" },
          "camera_lens": { "type": "string" },
          "lighting": { "type": "string" },
          "material_texture": { "type": "string" },
          "color_hierarchy": { "type": "string" },
          "color_system": { "type": "string" },
          "depth_layering": { "type": "string" },
          "text_safe_zones": { "type": "string" },
          "motion_usage": { "type": "string" },
          "animation_affordance": { "type": "string" },
          "primary_animated_object": { "type": "string" },
          "dark_light_motion_rule": { "type": "string" },
          "negative_prompt": { "type": "string" },
          "regeneration_criteria": { "type": "string" },
          "diversity_check": { "type": "string" },
          "generation_method": { "type": "string" },
          "asset_source_type": { "enum": ["proof", "support", "generated", "free_stock", "audio", "subtitle"] },
          "source_note": { "type": "string" },
          "copyright_status": {
            "enum": ["self_captured", "self_created", "official_reference", "licensed", "user_provided", "unknown"]
          },
          "resolution": { "type": "string" },
          "used_in_scenes": { "type": "array", "items": { "type": "string" } },
          "is_evidence": { "type": "boolean" },
          "risk": { "enum": ["low", "medium", "high"] },
          "contains_private_info": { "type": "boolean" },
          "contains_contact_info": { "type": "boolean" },
          "contains_qr_code": { "type": "boolean" },
          "qa_notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "asset_role": { "const": "background_plate" } },
              "required": ["asset_role"]
            },
            "then": {
              "required": ["visual_thesis", "topic_binding", "information_job", "background_role"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "generated_visual" } },
              "required": ["type"]
            },
            "then": {
              "required": [
                "model",
                "prompt_id",
                "prompt_path",
                "unique_prompt",
                "evidence_boundary",
                "scene_id",
                "narration_line_supported",
                "scene_function",
                "visual_archetype",
                "brightness_grade",
                "palette_family",
                "material_family",
                "layout_family",
                "energy_level",
                "visual_thesis",
                "topic_binding",
                "beginner_usefulness",
                "information_job",
                "viewer_takeaway",
                "composition",
                "foreground",
                "midground",
                "background",
                "camera_lens",
                "lighting",
                "material_texture",
                "color_hierarchy",
                "color_system",
                "depth_layering",
                "text_safe_zones",
                "motion_usage",
                "animation_affordance",
                "primary_animated_object",
                "dark_light_motion_rule",
                "negative_prompt",
                "regeneration_criteria",
                "diversity_check"
              ]
            }
          }
        ]
      }
    }
  }
}
