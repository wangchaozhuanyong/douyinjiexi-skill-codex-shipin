{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production postmortem",
  "type": "object",
  "required": [
    "project",
    "topic",
    "qa_status",
    "decision_summary",
    "observations",
    "what_worked",
    "what_to_fix",
    "bottlenecks",
    "reusable_lessons",
    "next_run_decisions",
    "proposed_rule_changes",
    "human_approval_required"
  ],
  "properties": {
    "project": { "type": "string" },
    "topic": { "type": "string" },
    "qa_status": { "type": "string" },
    "decision_summary": { "type": "string" },
    "user_feedback": { "type": "string" },
    "observations": { "type": "array", "items": { "type": "string" } },
    "what_worked": { "type": "array", "items": { "type": "string" } },
    "what_to_fix": { "type": "array", "items": { "type": "string" } },
    "bottlenecks": { "type": "array", "items": { "type": "string" } },
    "reusable_lessons": { "type": "array", "items": { "type": "string" } },
    "next_run_decisions": { "type": "array", "items": { "type": "string" } },
    "proposed_rule_changes": { "type": "array", "items": { "type": "string" } },
    "human_approval_required": { "type": "boolean" },
    "source_reports": { "type": "array", "items": { "type": "string" } }
  }
}
