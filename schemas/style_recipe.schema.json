{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style Recipe",
  "type": "object",
  "required": [
    "status",
    "selected_visual_family",
    "background_style_id",
    "component_ids",
    "motion_primitives",
    "caption_template_family",
    "transition_language",
    "sfx_character",
    "cooldown"
  ],
  "properties": {
    "status": {"enum": ["passed", "locked"]},
    "selected_visual_family": {"type": "string", "minLength": 3},
    "background_style_id": {"type": "string", "minLength": 3},
    "component_ids": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "motion_primitives": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "caption_template_family": {"type": "string", "minLength": 3},
    "transition_language": {"type": "string", "minLength": 10},
    "sfx_character": {"type": "string", "minLength": 10},
    "cooldown": {"type": "object"}
  }
}
