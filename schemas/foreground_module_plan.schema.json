{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foreground module plan",
  "type": "object",
  "required": ["status", "version", "aspect_ratio", "scenes"],
  "properties": {
    "status": { "enum": ["planned", "passed", "failed"] },
    "version": { "type": "integer", "minimum": 1 },
    "aspect_ratio": { "enum": ["16:9", "9:16"] },
    "layout_mode": {
      "enum": ["no_presenter", "presenter_left", "presenter_right", "portrait_no_presenter", "portrait_presenter"]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "parent_module_id", "text_slots", "micro_components", "transition_in", "transition_out"],
        "properties": {
          "scene_id": { "type": "string", "minLength": 1 },
          "aspect_ratio": { "enum": ["16:9", "9:16"] },
          "layout_mode": { "type": "string" },
          "parent_module_id": { "pattern": "^M(0[1-9]|1[0-9]|20)$" },
          "text_slots": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "micro_components": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["component_id", "anchor", "phase", "instance_count", "text_slots"],
              "properties": {
                "component_id": { "pattern": "^C(0[1-9]|[12][0-9]|30)$" },
                "anchor": { "type": "string", "minLength": 1 },
                "phase": { "enum": ["assemble", "load", "process", "resolve", "hold", "exit"] },
                "instance_count": { "type": "integer", "minimum": 1 },
                "text_slots": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          },
          "transition_in": { "pattern": "^TR0[1-8]$" },
          "transition_out": { "pattern": "^TR0[1-8]$" }
        }
      }
    }
  }
}
