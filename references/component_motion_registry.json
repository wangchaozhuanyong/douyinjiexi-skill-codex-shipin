{
  "version": "2026-06-19",
  "motion_primitives": [
    {
      "id": "scan",
      "purpose": "verify a source, screenshot, or proof module",
      "duration_ms": [180, 260],
      "limits": "not repeated more than twice in one scene"
    },
    {
      "id": "assemble",
      "purpose": "build a step, checklist row, or prompt block from a port or rail",
      "duration_ms": [220, 380],
      "limits": "avoid whole-card pop-in"
    },
    {
      "id": "lock",
      "purpose": "confirm a claim, result, or final answer",
      "duration_ms": [80, 140],
      "limits": "one pulse only, no blinking loop"
    },
    {
      "id": "focus",
      "purpose": "pull attention to proof without hiding readability",
      "duration_ms": [500, 900],
      "limits": "background dim 8-15 percent only"
    },
    {
      "id": "converge",
      "purpose": "merge scattered points into a final workflow or conclusion",
      "duration_ms": [450, 850],
      "limits": "no explosive flash"
    }
  ],
  "components": [
    {
      "id": "result_first_hook",
      "role": "hook",
      "schemes": ["scheme_2_source_led_tool_tutorial", "scheme_6_operation_proof_short"],
