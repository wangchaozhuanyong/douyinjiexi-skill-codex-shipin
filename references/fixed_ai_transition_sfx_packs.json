{
  "version": 1,
  "library_name": "fixed_ai_transition_sfx_packs",
  "selection_policy": "semantic_fit_then_sequential_rotation",
  "rules": {
    "one_main_pack_per_video": true,
    "one_optional_secondary_pack": true,
    "visual_transitions_never_control_narration": true,
    "sfx_below_narration_db": [-18, -12],
    "no_low_grade_whoosh": true,
    "no_full_screen_flash": true,
    "premium_only_default": true,
    "forbidden_low_grade_effects": [
      "diagonal line sweep",
      "斜线扫光",
      "random horizontal light streak",
      "横向小光条乱跑",
      "plain fade",
      "普通淡入淡出",
      "simple slide",
      "普通左右滑入",
      "decoration-only connector line",
      "无信息作用线条",
      "empty rail sweep",
      "空导轨扫过",
      "card carousel",
      "旧卡片轮播"
    ],
    "handoff_required": true,
    "transition_must_move_information_state": true
  },
  "packs": [
    {
      "id": "TRN_PACK_01",
      "name": "钛金舱门信息交接",
      "scheme_ids": ["scheme_2_source_led_tool_tutorial", "scheme_4_multi_skill_stack_explainer", "scheme_6_operation_proof_short"],
      "visual_families": ["titanium_neural_control_room", "source_archive_wall", "quantum_ring_core"],
      "recipe_id": "metal_aperture_handoff",
      "quality_tier": "premium_only",
      "transition_language": "当前来源、步骤或结果模块先收束成钛金信息芯片，金属舱门沿模块边缘开合，芯片被交接到下一镜头的主信息位。",
      "duration_frames": [10, 14],
      "motion_primitives": ["semantic_compress", "aperture_open", "assemble", "lock"],
      "sfx_cues": ["low metal aperture tick", "soft panel settle", "short clean lock click"],
      "limits": "每个镜头显著动作不超过两个；禁止斜线扫光、闪白、爆光、随机光条和大幅旋转。"
    },
    {
      "id": "TRN_PACK_02",
      "name": "玻璃棱镜折射切换",
      "scheme_ids": ["scheme_4_multi_skill_stack_explainer", "scheme_6_operation_proof_short"],
      "visual_families": ["quantum_ring_core", "cosmic_ai_network"],
      "recipe_id": "glass_prism_refraction",
      "quality_tier": "premium_only",
      "transition_language": "上一镜头的核心文本或证据卡被折射成两层玻璃棱镜，棱镜旋开时露出下一镜头同一信息的升级状态。",
      "duration_frames": [12, 16],
      "motion_primitives": ["refract", "depth_swap", "focus", "lock"],
      "sfx_cues": ["soft glass tick", "low energy pulse", "clean lock click"],
      "limits": "折射只作用于边框和信息层，不扭曲正文；不能遮挡字幕。"
    },
    {
      "id": "TRN_PACK_03",
      "name": "来源证据聚焦锁定",
      "scheme_ids": ["scheme_2_source_led_tool_tutorial", "scheme_3_ai_news_to_beginner_action"],
      "visual_families": ["source_archive_wall"],
      "recipe_id": "source_evidence_focus",
      "quality_tier": "premium_only",
      "transition_language": "来源证据卡先被镜头光阑聚焦，日期、来源和结论三个证据点依次锁定，随后把结论点交给下一镜头的步骤模块。",
      "duration_frames": [10, 13],
      "motion_primitives": ["focus", "evidence_pin", "handoff", "lock"],
      "sfx_cues": ["subtle proof tick", "short clean lock click"],
      "limits": "官方截图内部不加滤镜、不变色、不持续闪烁；禁止装饰性扫描线当主转场。"
    },
    {
      "id": "TRN_PACK_04",
      "name": "信息层级装配",
      "scheme_ids": ["scheme_2_source_led_tool_tutorial", "scheme_5_checklist_template_poster"],
      "visual_families": ["white_ice_tool_lab", "deep_data_light_rail"],
      "recipe_id": "layered_information_assembly",
      "quality_tier": "premium_only",
      "transition_language": "上一个结论拆成标题层、证据层、动作层三片玻璃，每片按口播顺序装配到下一镜头，不做空白装饰切片。",
      "duration_frames": [11, 15],
      "motion_primitives": ["layer_split", "semantic_assemble", "focus"],
      "sfx_cues": ["soft panel settle", "subtle digital tick"],
      "limits": "避免硬切、整屏毛玻璃、斜向装饰线和信息糊掉。"
    },
    {
      "id": "TRN_PACK_05",
      "name": "任务状态锁定",
      "scheme_ids": ["scheme_3_ai_news_to_beginner_action", "scheme_5_checklist_template_poster"],
      "visual_families": ["black_gold_strategy_chamber"],
      "recipe_id": "state_lock_microinteraction",
      "quality_tier": "premium_only",
      "transition_language": "当前任务状态先变成锁定节点，节点发出低亮度脉冲并带着状态文字进入下一镜头的清单位置。",
      "duration_frames": [12, 16],
      "motion_primitives": ["state_pin", "lock", "handoff"],
      "sfx_cues": ["low energy pulse", "short clean lock click", "soft panel settle"],
      "limits": "只锁定真实状态节点，不把整屏做成装饰锁动画；金光透明度必须克制。"
    },
    {
      "id": "TRN_PACK_06",
      "name": "光标路径操作",
      "scheme_ids": ["scheme_3_ai_news_to_beginner_action", "scheme_5_checklist_template_poster"],
      "visual_families": ["deep_data_light_rail", "cosmic_ai_network"],
      "recipe_id": "cursor_path_operation",
      "quality_tier": "premium_only",
      "transition_language": "光标从上一个动作终点沿最短操作路径移动到下一步输入位，路径只连接真实操作点，并在目标处产生轻锁定反馈。",
      "duration_frames": [14, 20],
      "motion_primitives": ["cursor_trace", "operation_path", "focus", "lock"],
      "sfx_cues": ["cursor tap", "subtle digital tick", "soft panel settle"],
      "limits": "路径不能穿过字幕和正文；禁止随机线条代替操作路径。"
    },
    {
      "id": "TRN_PACK_07",
      "name": "证明放大镜切换",
      "scheme_ids": ["scheme_4_multi_skill_stack_explainer", "scheme_6_operation_proof_short"],
      "visual_families": ["titanium_neural_control_room", "quantum_ring_core"],
      "recipe_id": "proof_lens_magnification",
      "quality_tier": "premium_only",
      "transition_language": "镜头用局部证明放大镜锁住来源、命令或结果中的关键区域，放大镜收缩后转化为下一镜头的主卡片。",
      "duration_frames": [12, 18],
      "motion_primitives": ["proof_lens", "focus", "morph_to_card", "lock"],
      "sfx_cues": ["subtle proof tick", "soft panel settle", "short clean lock click"],
      "limits": "只放大真实证据区域，不扭曲正文和截图。"
    },
    {
      "id": "TRN_PACK_08",
      "name": "语义节点接力",
      "scheme_ids": ["scheme_3_ai_news_to_beginner_action", "scheme_4_multi_skill_stack_explainer", "scheme_5_checklist_template_poster"],
      "visual_families": ["cosmic_ai_network", "deep_data_light_rail"],
      "recipe_id": "semantic_node_relay",
      "quality_tier": "premium_only",
      "transition_language": "上一个镜头的关键词节点沿短路径传给下一镜头对应信息槽，节点必须携带文字或状态，不允许空节点飘动。",
      "duration_frames": [13, 18],
      "motion_primitives": ["semantic_node", "relay", "assemble"],
      "sfx_cues": ["low energy pulse", "subtle digital tick"],
      "limits": "禁止爆炸式粒子、随机斜线和无信息节点；节点数量少而精。"
    },
    {
      "id": "TRN_PACK_09",
      "name": "清单矩阵装配",
      "scheme_ids": ["scheme_1_skill_recommendation_no_voice", "scheme_5_checklist_template_poster"],
      "visual_families": ["vertical_tool_test_chamber", "vertical_workflow_spine", "vertical_ai_trend_star_map"],
      "recipe_id": "checklist_matrix_assembly",
      "quality_tier": "premium_only",
      "transition_language": "清单项从上一镜头的结论区按网格坐标装配，不使用轮播；每项落位后有一次低声勾选反馈。",
      "duration_frames": [10, 14],
      "motion_primitives": ["grid_assemble", "check", "lock"],
      "sfx_cues": ["soft checklist tick", "subtle digital tick"],
      "limits": "必须使用固定网格坐标，避开抖音右侧操作栏和底部标题区。"
    },
    {
      "id": "TRN_PACK_10",
      "name": "结论模板收束",
      "scheme_ids": ["scheme_2_source_led_tool_tutorial", "scheme_3_ai_news_to_beginner_action", "scheme_4_multi_skill_stack_explainer", "scheme_5_checklist_template_poster", "scheme_6_operation_proof_short"],
      "visual_families": ["titanium_neural_control_room", "cosmic_ai_network", "black_gold_strategy_chamber", "quantum_ring_core"],
      "recipe_id": "final_template_convergence",
      "quality_tier": "premium_only",
      "transition_language": "来源、步骤和结果三个信息对象收束成一张可保存模板，模板落位后只保留轻微呼吸光，不做普通缩放结尾。",
      "duration_frames": [16, 24],
      "motion_primitives": ["semantic_converge", "template_build", "lock"],
      "sfx_cues": ["low energy pulse", "soft panel settle"],
      "limits": "只用于结尾或总结，不在每一页重复使用。"
    }
  ]
}
