      "motion": ["focus", "lock"],
      "caption_family": "bottom_glass_keyword",
      "cooldown_after_uses": 2
    },
    {
      "id": "source_wall_grid",
      "role": "source",
      "schemes": ["scheme_2_source_led_tool_tutorial", "scheme_3_ai_news_to_beginner_action", "scheme_7_ai_hot_rank_top5"],
