{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Research",
  "type": "object",
  "required": ["status", "sources"],
  "properties": {
    "status": { "enum": ["passed", "draft"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url_or_local_capture",
          "published_or_captured_date",
          "source_type",
          "claim_supported",
          "asset_potential"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "url_or_local_capture": { "type": "string" },
          "published_or_captured_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "source_type": {
            "enum": ["official_doc", "release_note", "credible_news", "local_capture", "user_reference"]
          },
          "claim_supported": { "type": "string" },
          "asset_potential": {
            "enum": ["screenshot", "quote_card", "timeline", "comparison", "demo"]
          }
        }
      }
    }
  }
}
